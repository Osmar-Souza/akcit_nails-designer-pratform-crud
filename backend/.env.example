# Backend - Variáveis de Ambiente

# Porta do servidor (padrão: 3333)
PORT=3333

# PostgreSQL URL
# Para desenvolvimento local:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/akcit
# Para produção, use uma URL segura com usuário, senha e hostname corretos.
DATABASE_URL=postgresql://postgres:325498@localhost:5432/akcit

# CORS - URL do frontend (adicione sua URL do frontend em produção)
# FRONTEND_URL=https://seu-frontend.vercel.app
